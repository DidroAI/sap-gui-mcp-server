{
  "manifest_version": 3,
  "name": "Agent Connector for SAP Systems",
  "short_name": "Agent Connector",
  "description": "Lets your local AI agent open and log on to your SAP systems. Passwords stay in your keychain. Not affiliated with SAP SE.",
  "version": "0.3.0",
  "minimum_chrome_version": "132",
  "homepage_url": "https://github.com/DidroAI/sap-gui-mcp-server/tree/main/extension",
  "key": "",
  "permissions": [
    "debugger",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Agent Connector for SAP Systems",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
