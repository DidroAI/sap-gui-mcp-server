{
  "manifest_version": 3,
  "name": "sap-gui-mcp-server bridge",
  "short_name": "MCP bridge",
  "description": "Lets your local sap-gui-mcp-server work in the browser tabs of sites you allow, after pairing with a code.",
  "version": "0.1.0",
  "minimum_chrome_version": "132",
  "permissions": ["debugger", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "sap-gui-mcp-server bridge",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "storage": { "managed_schema": "managed_schema.json" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
