{
  "name": "sap-ui-automation",
  "version": "0.3.0",
  "description": "MCP server, CLI and SDK that let an agent see and drive SAP screens: SAP GUI for Windows, SAP GUI for HTML (Web GUI) and SAP Fiori, in a compact, complete text view",
  "license": "MIT",
  "author": "Didro",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "sap",
    "sap-gui",
    "sap-gui-scripting",
    "sap-webgui",
    "webgui",
    "sap-fiori",
    "fiori",
    "ui5",
    "sapui5",
    "s4hana",
    "test-automation",
    "cli",
    "sdk",
    "agent",
    "claude",
    "codex",
    "cursor"
  ],
  "mcpName": "io.github.DidroAI/sap-ui-automation",
  "homepage": "https://github.com/DidroAI/sap-ui-automation#readme",
  "bugs": {
    "url": "https://github.com/DidroAI/sap-ui-automation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DidroAI/sap-ui-automation.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/runner/index.d.ts",
      "default": "./dist/runner/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sap-ui-automation": "dist/cli.js",
    "sap-gui": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "skills",
    "docs/**/*.md",
    "!docs/node_modules/**",
    "extension",
    "!extension/REVIEW.md",
    "!extension/STORE.md",
    "native-host",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test",
    "start": "node dist/cli.js",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "docs:dev": "cd docs && bun install --frozen-lockfile && bun run dev",
    "docs:build": "cd docs && bun install --frozen-lockfile && bun run build",
    "pack:extension": "node scripts/pack-extension.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright-core": "1.65.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
